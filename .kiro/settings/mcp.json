{
  "mcpServers": {
    "aws-knowledge": {
      "url": "https://knowledge-mcp.global.api.aws",
      "autoApprove": [
        "search_documentation",
        "read_documentation"
      ],
      "disabled": false
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "autoApprove": [],
      "disabled": true
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        ".lab/orders.db"
      ],
      "autoApprove": [],
      "disabledTools": [
        "write_query",
        "create_table"
      ],
      "disabled": true
    }
  }
}
